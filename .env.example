# ---------------------------------------------------------------------------
# TOC Luxury Constructions Ltd — environment configuration
# Copy to `.env` (never commit `.env`). Only VITE_-prefixed values are exposed
# to the browser — never put API secrets, SMTP passwords or private tokens here.
# ---------------------------------------------------------------------------

# Canonical public URL of the deployed site (used for canonical tags, sitemap
# and structured data). Replace once the final domain is approved.
VITE_SITE_URL=https://www.tocluxuryconstructions.com

# OPTIONAL — HTTPS endpoint that accepts the inquiry form as JSON POST.
# Leave empty to run the form in WhatsApp-handoff mode (no data is sent).
# Example: https://formspree.io/f/xxxxxxx
VITE_INQUIRY_ENDPOINT=

# OPTIONAL — HTTPS endpoint that accepts consultation requests as JSON POST.
# Falls back to VITE_INQUIRY_ENDPOINT when empty.
VITE_CONSULTATION_ENDPOINT=

# OPTIONAL — HTTPS endpoint for secure attachment uploads (multipart/form-data).
# The attachment field stays disabled until this is set AND server-side
# validation (file type, size, malware scanning, access control) exists.
VITE_INQUIRY_UPLOAD_ENDPOINT=

# OPTIONAL — Google Maps Embed API key, only if a Google map iframe is wanted
# instead of the default OpenStreetMap embed. Restrict the key by HTTP referrer.
VITE_GOOGLE_MAPS_EMBED_KEY=

# ---------------------------------------------------------------------------
# Admin backend (server/index.js). These are SERVER-ONLY — they are never
# exposed to the browser because they are not prefixed with VITE_.
# ---------------------------------------------------------------------------

# Port the API listens on. The built site is served by the same process.
API_PORT=8787

# Where the site is served from. "127.0.0.1" for a host behind a reverse proxy,
# "0.0.0.0" to bind every interface.
HOST=0.0.0.0
NODE_ENV=production

# Set this to true only when a trusted proxy (Nginx, Caddy, a PaaS router)
# terminates TLS in front of the app; it is needed for correct client IPs.
TRUST_PROXY=false

# --- Administrator credential -------------------------------------------
# Choose ONE of the two — or neither, and set the password from the first-run
# screen at /admin instead (then it is stored hashed in server/data/auth.json and
# can be changed or reset from the admin itself).
#
# With ADMIN_PASSWORD set, the credential is under environment control: the
# admin shows it as such and refuses to change it, and the forgotten-password
# flow is switched off — edit this file and restart instead.
ADMIN_PASSWORD=
# Alternative: the scrypt hash produced by `npm run admin:hash -- "your password"`.
# Prefer this if you would rather not keep the plaintext on the server.
ADMIN_PASSWORD_HASH=

# --- Password resets (optional) -----------------------------------------
# The admin has a "Forgotten your password?" flow on the sign-in screen. A
# one-time code is created and can be delivered two ways; set ONE (or neither).
#
# 1. SMTP — requires nodemailer (npm install nodemailer) on the server.
#    Example: smtp://user:password@smtp.example.com:587
SMTP_URL=
MAIL_FROM=
#
# 2. A webhook on your own mail relay: the server POSTs JSON
#    {to, subject, text, code} to this URL. No dependency, works with a
#    Zapier/Make/Cloudflare Worker step that sends the mail.
RESET_WEBHOOK_URL=
#
# With neither set, the code is written to server/data/reset-code.txt (mode 600)
# and the sign-in screen says exactly that — nothing is ever described as emailed
# when it was not. Codes expire after RESET_MINUTES and die after five attempts.
RESET_MINUTES=30

# --- Session -------------------------------------------------------------
# Random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# If left empty, a key is derived from the stored credential (fine for a single
# server, but a restart invalidates sessions).
SESSION_SECRET=
SESSION_HOURS=12

# --- Storage -------------------------------------------------------------
# Where admin-uploaded images are written and served from.
UPLOADS_DIR=server/data/uploads
# Content document the admin edits, and where backups/submissions are kept.
DATA_DIR=server/data
CONTENT_FILE=content/site.json

# Maximum size of a single uploaded image, in bytes (default 8 MB).
MAX_UPLOAD_BYTES=8388608

# --- Embedding ------------------------------------------------------------
# true  (default) — the site and the admin may be shown inside a frame belonging
#                   to another page, so they work in a preview panel or a
#                   client's own site.
# false           — send X-Frame-Options: SAMEORIGIN on /admin and refuse to be
#                   framed anywhere. The right choice once the site is live on
#                   its real domain and nobody needs to preview it in a panel.
EMBEDDABLE=true
