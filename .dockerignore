# Keep the build context small and never bake secrets or runtime state into an image.
node_modules
dist
.git
.gitignore

# Secrets
.env
.env.*
!.env.example

# Runtime state — lives on a mounted volume instead, never in the image
server/data

# Docs, tests and editor noise are not needed to build or run
docs
*.md
!README.md
.vscode
.idea
.DS_Store
*.log
